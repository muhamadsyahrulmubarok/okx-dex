OKX_API_KEY=your_key
OKX_SECRET_KEY=your_secret
OKX_PASSPHRASE=your_passphrase
BASE_URL=https://www.okx.com
# Set to true for OKX simulated trading.
OKX_SIMULATED=false

# Backend control API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
BACKEND_DB_PATH=backend.db
BOT_AUTO_START=false
BOOTSTRAP_CONFIG_PATH=config.json

# Worker runtime
CONTROL_API_BASE_URL=http://backend:8080
POSITIONS_DB_PATH=positions.db
WORKER_LOG_LEVEL=INFO
WORKER_SCRIPT=okx_worker.py
PYTHON_BIN=python3

# Global runtime market mode (CEX or DEX)
MARKET_TYPE=CEX

# DEX runtime defaults (used when MARKET_TYPE=DEX)
DEX_BASE_URL=https://web3.okx.com
# OKX Web3 project id for DEX API headers (OK-ACCESS-PROJECT)
DEX_PROJECT_ID=your_okx_web3_project_id
DEX_CHAIN_ID=1
# Example Ethereum mainnet USDT
DEX_QUOTE_TOKEN_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7
DEX_QUOTE_TOKEN_DECIMALS=6
DEX_SLIPPAGE=0.005
DEX_WALLET_ADDRESS=0xYourWalletAddress
# Optional: required only when enabling DEX_LIVE_EXECUTE=true
DEX_PRIVATE_KEY=
DEX_RPC_URL=https://mainnet.infura.io/v3/your_project_id
DEX_LIVE_EXECUTE=false
DEX_PRICE_PROBE_QUOTE_AMOUNT=1.0

# Telegram notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=123456789:your_bot_token
TELEGRAM_CHAT_ID=123456789
# Optional: send open positions snapshot every cycle (can be noisy)
TELEGRAM_NOTIFY_POSITIONS=false
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_BACKOFF_SECONDS=1.5
